# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_token_here

# Discord Application/Client ID (from Developer Portal)
CLIENT_ID=your_client_id_here

# PTT scraper poll interval in milliseconds (default: 300000 = 5 minutes)
POLL_INTERVAL_MS=300000

# Cooldown between board requests in milliseconds (default: 5000 = 5 seconds)
COOLDOWN_MS=5000

# Funbox shop restock poll interval in milliseconds (default: 300000 = 5 minutes)
SHOP_POLL_INTERVAL_MS=300000

# Eslite exhibition restock poll interval in milliseconds (default: 300000 = 5 minutes)
ESLITE_POLL_INTERVAL_MS=300000

# Optional: Custom Cloudflare Worker proxy for Eslite API (bypasses 403 blocks)
# If omitted or fails, scraper automatically falls back to local Chrome TLS impersonation
ESLITE_API_BASE=https://eslite-proxy.abc12david.workers.dev/api/v1/book_exhibits
ESLITE_FAST_POLL_ENABLED=true

# Momo category restock poll interval in milliseconds (default: 300000 = 5 minutes)
MOMO_POLL_INTERVAL_MS=300000

# Auto-buy: AES-256-GCM encryption key for storing user session cookies
# Generate with: openssl rand -hex 32
# REQUIRED if you want to use /shop-autobuy setup
AUTOBUY_SECRET=
